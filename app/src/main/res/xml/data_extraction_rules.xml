<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+ 的备份 / 设备迁移规则。
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- DataStore 中保存了 API Key，禁止随云备份上传 -->
        <exclude domain="file" path="datastore/meapet_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- 设备间迁移同样排除，避免密钥落入非预期设备 -->
        <exclude domain="file" path="datastore/meapet_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
